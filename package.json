{
  "name": "synthesis-sabatier-frontend",
  "private": true,
  "version": "7.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "generate-api": "node scripts/generate-api.mjs",
    "build:pages": "tsc -b && vite build --mode pages && cp dist/index.html dist/404.html",
    "predeploy": "npm run build:pages",
    "deploy": "gh-pages -d dist -b gh-pages",
    "cert": "node scripts/generate-cert.mjs"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.14.0",
    "axios": "^1.21.0",
    "bootstrap": "^5.3.3",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.5",
    "react-dom": "^18.3.1",
    "react-redux": "^9.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.2",
    "gh-pages": "^6.3.0",
    "mkcert": "^3.2.0",
    "swagger-typescript-api": "^13.13.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^2.0.0"
  }
}
